<?xml version="1.0"?>
<package format="3">
  <name>igvc_sim</name>
  <version>0.1.0</version>
  <description>Dynamic IGVC AutoNav Gazebo course generator</description>
  <maintainer email="igvc@example.com">IGVC</maintainer>
  <license>MIT</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>diff_drive_robot</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <export>
    <build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models" gazebo_media_path="${prefix}/worlds"/>
  </export>
</package>
