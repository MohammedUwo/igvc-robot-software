# IGVC robot udev rules template.
# Install with: sudo cp 99-igvc-robot.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Serial mapping must be confirmed before enabling final names.

# ESP32 current/e-stop board: currently /dev/ttyUSB0
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="ee1d877cc382ee11901a429ec33d7414", SYMLINK+="igvc_estop", GROUP="dialout", MODE="0666"

# RPLIDAR A-series USB adapter: currently /dev/ttyUSB1
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0001", SYMLINK+="igvc_rplidar", GROUP="dialout", MODE="0666"

# Candidate Emlid Reach RS+ GPS serial adapter: currently /dev/ttyACM0
# Keep a stable GPS symlink, but this host still needs dialout/session permission fixed before user-space access succeeds.
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2323", ATTRS{serial}=="AVCFz114J20", SYMLINK+="igvc_gps", GROUP="dialout", MODE="0666"

# OAK-D / MyriadX access
SUBSYSTEM=="usb", ATTR{idVendor}=="03e7", MODE="0666", GROUP="plugdev"

# Intel RealSense D435 access
SUBSYSTEM=="usb", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b07", MODE="0666", GROUP="plugdev"

# ODrive V3.6 native USB/Fibre interface and CDC serial interface observed as serial 315B32623431.
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="0d32", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0d32", ATTRS{serial}=="315B32623431", SYMLINK+="igvc_odrive", GROUP="dialout", MODE="0666"
