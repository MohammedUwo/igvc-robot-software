<?xml version="1.0"?>
<package format="3">
  <name>igvc_estop_current</name>
  <version>0.1.0</version>
  <description>ROS 2 serial bridge for IGVC ESP32 e-stop and ODrive current sensor telemetry.</description>
  <maintainer email="igvc@example.com">IGVC</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
